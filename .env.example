# Environment
ENV=development

# Database
DATABASE_URL=sqlite:///./data/mfit_hevy.db

# Hevy API
HEVY_API_BASE_URL=https://api.hevyapp.com
HEVY_API_KEY=your-hevy-pro-api-key-here

# API Configuration
API_TITLE=MFIT → Hevy Orchestrator
API_VERSION=0.1.0
API_DESCRIPTION=Sistema seguro para importar fichas de treino do MFIT para o Hevy

# Logging
LOG_LEVEL=INFO

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=30000
